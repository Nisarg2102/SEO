# ─── Database (Neon/PostgreSQL) ─────────────────────────────────────────────────────────────
# DATABASE_URL should be the POOLED connection string (e.g. ends with ?pgbouncer=true or -pooler.neon.tech)
DATABASE_URL="postgresql://user:pass@ep-rest-of-host-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15"
# DIRECT_URL should be the UNPOOLED connection string used exclusively for Prisma migrations
DIRECT_URL="postgresql://user:pass@ep-rest-of-host.region.aws.neon.tech/neondb?connect_timeout=15"

# ─── Queues (Upstash QStash) ─────────────────────────────────────────────────────────────
QSTASH_TOKEN=<YOUR_QSTASH_TOKEN>
QSTASH_CURRENT_SIGNING_KEY=<YOUR_QSTASH_CURRENT_SIGNING_KEY>
QSTASH_NEXT_SIGNING_KEY=<YOUR_QSTASH_NEXT_SIGNING_KEY>

# ─── Backend ──────────────────────────────────────────────────────────────────
# Base URL of the API for QStash callbacks (e.g., https://api.yourdomain.com)
API_URL=http://localhost:3001
PORT=3001

# REQUIRED: Minimum 32 characters of random bytes. Generate with:
#   openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_MIN_32_CHARS>

# Allowed frontend origin for CORS. No trailing slash.
FRONTEND_URL=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# The base URL the frontend uses to contact the API. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── AI Provider (Ollama Local AI) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Google OAuth (Search Console) ───────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://localhost:3001/gsc/callback


# ─── n8n Webhook Authentication ───────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
# Never use a default or simple value.
N8N_WEBHOOK_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL>


# ─── pgAdmin (development only — do not expose in production) ────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME>
