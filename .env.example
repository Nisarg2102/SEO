# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=ai_marketing
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── Redis & Queues ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED: Minimum 32 characters of random bytes. Generate with:
#   openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_MIN_32_CHARS>

# Allowed frontend origin for CORS. No trailing slash.
FRONTEND_URL=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# The base URL the frontend uses to contact the API. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_MODEL=gpt-4o
AI_API_KEY=<YOUR_OPENAI_API_KEY>

# ─── Google OAuth (Search Console) ───────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://localhost:3001/gsc/callback

# ─── OpenSEO Integration ──────────────────────────────────────────────────────
OPENSEO_URL=
OPENSEO_API_KEY=

# ─── n8n Webhook Authentication ───────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
# Never use a default or simple value.
N8N_WEBHOOK_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL>

# ─── Postiz Social Publishing ─────────────────────────────────────────────────
POSTIZ_URL=
POSTIZ_API_KEY=
# REQUIRED: Shared secret for Postiz → our backend webhooks
POSTIZ_WEBHOOK_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL>

# ─── pgAdmin (development only — do not expose in production) ────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME>
