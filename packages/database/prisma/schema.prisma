generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  name             String
  passwordHash     String            @map("password_hash")
  role             String            @default("USER")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  type           String
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  brandProfiles  BrandProfile[]
  sources        Source[]
  researchItems  ResearchItem[]
  contentPacks     ContentPack[]
  seoOpportunities SeoOpportunity[]
  integrations     Integration[]
  gscMetrics       GscMetric[]
  analyticsAccounts AnalyticsAccount[]
  agentConversations AgentConversation[]
  automations        Automation[]
  weeklyReports    WeeklyReport[]
  contentIdeas     ContentIdea[]
  seoAudits        SeoAudit[]
  seoLinks         SeoLink[]
  seoContentAnalyses SeoContentAnalysis[]
  seoContentBriefs SeoContentBrief[]
  seoContentDrafts SeoContentDraft[]
  socialContent  SocialContent[]
  socialAccountMetrics SocialAccountMetric[]
  googleConnections GoogleConnection[]
  searchConsoleProperties SearchConsoleProperty[]
  syncRuns SyncRun[]

  @@map("workspaces")
}

model WorkspaceMember {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         String
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model BrandProfile {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  businessName    String    @map("business_name")
  industry        String
  targetAudience  String    @map("target_audience")
  brandVoice      String?   @map("brand_voice")
  primaryKeywords String?   @map("primary_keywords")
  website         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("brand_profiles")
}

model Source {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  name         String
  url          String
  sourceType   String    @map("source_type")
  sourceTier   String    @map("source_tier")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchItems ResearchItem[]

  @@index([workspaceId])
  @@map("sources")
}

model ResearchItem {
  id                      String    @id @default(uuid()) @db.Uuid
  workspaceId             String    @map("workspace_id") @db.Uuid
  sourceId                String    @map("source_id") @db.Uuid
  title                   String
  url                     String
  topic                   String?
  audience                String?
  summary                 String    @db.Text
  relevanceReason         String?   @map("relevance_reason") @db.Text
  suggestedContentFormats String?   @map("suggested_content_formats") @db.Text
  publishedAt             DateTime? @map("published_at")
  confidence              Float
  intent                  String
  status                  String
  createdAt               DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  contentIdeas ContentIdea[]

  @@index([workspaceId])
  @@index([sourceId])
  @@unique([workspaceId, url])
  @@map("research_items")
}

model ContentIdea {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  researchItemId   String?   @map("research_item_id") @db.Uuid
  seoOpportunityId String?   @map("seo_opportunity_id") @db.Uuid
  title            String
  topic            String
  audience         String
  intent           String
  status           String
  confidence       Float
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchItem     ResearchItem?   @relation(fields: [researchItemId], references: [id], onDelete: SetNull)
  seoOpportunity   SeoOpportunity? @relation(fields: [seoOpportunityId], references: [id], onDelete: SetNull)
  contentPacks     ContentPack[]

  @@index([workspaceId])
  @@index([researchItemId])
  @@index([seoOpportunityId])
  @@map("content_ideas")
}

model ContentPack {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  contentIdeaId     String?   @map("content_idea_id") @db.Uuid
  topic             String?
  objective         String?
  audience          String?
  intent            String?
  platform          String
  hook              String?   @db.Text
  caption           String?   @db.Text
  script            String?   @db.Text
  visualDirection   String?   @map("visual_direction") @db.Text
  cta               String?   @db.Text
  hashtags          String?
  seoTitle          String?   @map("seo_title")
  metaDescription   String?   @map("meta_description") @db.Text
  primaryKeyword    String?   @map("primary_keyword")
  secondaryKeywords String?   @map("secondary_keywords")
  complianceNotes   String?   @map("compliance_notes") @db.Text
  status            String
  scheduledAt       DateTime? @map("scheduled_at")
  externalPostId    String?   @map("external_post_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentIdea     ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contentIdeaId])
  @@map("content_packs")
}

model SeoOpportunity {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  url             String
  keyword         String
  impressions     Int
  clicks          Int
  ctr             Float
  averagePosition Float     @map("average_position")
  opportunityType String    @map("opportunity_type")
  recommendation  String    @db.Text
  priority        String
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentIdeas    ContentIdea[]

  @@index([workspaceId])
  @@map("seo_opportunities")
}

model Integration {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  provider     String    // e.g., 'google_search_console'
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at")
  config       String?   @db.Text // JSON string for things like propertyUrl
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("integrations")
}

model GscMetric {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  date         DateTime
  query        String
  page         String
  clicks       Int
  impressions  Int
  ctr          Float
  position     Float
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@unique([workspaceId, date, query, page])
  @@map("gsc_metrics")
}

model AnalyticsSource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  category    String   // 'website', 'social', 'video'
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  
  accounts    AnalyticsAccount[]

  @@map("analytics_sources")
}

model AnalyticsAccount {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  accountName     String   @map("account_name")
  externalId      String?  @map("external_id")
  config          String?  @db.Text // JSON config
  createdAt       DateTime @default(now()) @map("created_at")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source          AnalyticsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshots       AnalyticsSnapshot[]
  postMetrics     PostMetric[]

  @@unique([workspaceId, sourceId, accountName])
  @@map("analytics_accounts")
}

model AnalyticsSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  date          DateTime
  
  // Normalized metrics
  impressions   Int      @default(0)
  reach         Int      @default(0)
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  
  // Extensible JSON for platform-specific metrics (e.g. CTR, Average Position)
  metadata      String?  @db.Text 
  
  createdAt     DateTime @default(now()) @map("created_at")

  account       AnalyticsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@map("analytics_snapshots")
}

model PostMetric {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  externalUrl   String?  @map("external_url")
  externalId    String?  @map("external_id")
  date          DateTime
  
  // Normalized metrics
  impressions   Int      @default(0)
  reach         Int      @default(0)
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  
  // Extensible JSON
  metadata      String?  @db.Text 
  
  createdAt     DateTime @default(now()) @map("created_at")

  account       AnalyticsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId, date])
  @@index([externalUrl])
  @@map("post_metrics")
}

model WeeklyReport {
  id                        String   @id @default(uuid()) @db.Uuid
  workspaceId               String   @map("workspace_id") @db.Uuid
  weekStartDate             DateTime @map("week_start_date")
  weekEndDate               DateTime @map("week_end_date")
  
  bestPerformingContent     String   @db.Text
  weakPerformingContent     String   @db.Text
  observedPatterns          String   @db.Text
  seoOpportunities          String   @db.Text
  contentRefreshOpportunities String   @db.Text
  suggestedExperiments      String   @db.Text
  nextWeekIdeas             String   @db.Text
  
  createdAt                 DateTime @default(now()) @map("created_at")

  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("weekly_reports")
}

model SeoAudit {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  baseUrl     String   @map("base_url")
  status      String   @default("pending")  // pending|running|completed|failed
  maxPages    Int      @default(25)          @map("max_pages")
  maxDepth    Int      @default(2)           @map("max_depth")
  pagesCrawled Int     @default(0)          @map("pages_crawled")
  pagesFailed  Int     @default(0)          @map("pages_failed")
  issueCount   Int     @default(0)          @map("issue_count")
  criticalCount Int    @default(0)          @map("critical_count")
  warningCount  Int    @default(0)          @map("warning_count")
  passedCount   Int    @default(0)          @map("passed_count")
  errorMessage  String? @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages        SeoAuditPage[]
  issues       SeoAuditIssue[]
  links        SeoLink[]

  @@index([workspaceId])
  @@map("seo_audits")
}

model SeoAuditPage {
  id           String   @id @default(uuid()) @db.Uuid
  auditId      String   @map("audit_id") @db.Uuid
  url          String
  finalUrl     String?  @map("final_url")
  statusCode   Int?     @map("status_code")
  contentType  String?  @map("content_type")
  responseTime Int?     @map("response_time")  // ms
  pageSize     Int?     @map("page_size")       // bytes
  wordCount    Int?     @map("word_count")
  title        String?  @db.Text
  metaDesc     String?  @map("meta_desc") @db.Text
  h1           String?  @db.Text
  isIndexable  Boolean? @map("is_indexable")
  hasCanonical Boolean? @map("has_canonical")
  canonicalUrl String?  @map("canonical_url")
  crawlDepth   Int      @default(0) @map("crawl_depth")
  failed       Boolean  @default(false)
  failReason   String?  @map("fail_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  audit        SeoAudit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues       SeoAuditIssue[]

  @@index([auditId])
  @@map("seo_audit_pages")
}

model SeoAuditIssue {
  id           String   @id @default(uuid()) @db.Uuid
  auditId      String   @map("audit_id") @db.Uuid
  pageId       String?  @map("page_id") @db.Uuid
  code         String
  severity     String   // critical|warning|info|pass
  title        String
  description  String   @db.Text
  evidence     String?  @db.Text
  recommendation String @map("recommendation") @db.Text
  url          String?
  createdAt    DateTime @default(now()) @map("created_at")

  audit        SeoAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page         SeoAuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([pageId])
  @@map("seo_audit_issues")
}

model SeoLink {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  auditId      String   @map("audit_id") @db.Uuid
  sourceUrl    String   @map("source_url")
  targetUrl    String   @map("target_url")
  linkType     String   @map("link_type") // INTERNAL | EXTERNAL
  anchorText   String?  @map("anchor_text") @db.Text
  rel          String?  
  isNofollow   Boolean  @default(false) @map("is_nofollow")
  isSponsored  Boolean  @default(false) @map("is_sponsored")
  isUgc        Boolean  @default(false) @map("is_ugc")
  statusCode   Int?     @map("status_code")
  discoveredAt DateTime @default(now()) @map("discovered_at")

  audit        SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([auditId])
  @@map("seo_links")
}

model SeoContentAnalysis {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  url               String
  primaryKeyword    String   @map("primary_keyword")
  secondaryKeywords String[] @map("secondary_keywords")
  country           String?
  language          String?
  searchIntent      String?  @map("search_intent")
  sourceSnapshot    Json     @map("source_snapshot")
  analysisResult    Json?    @map("analysis_result")
  status            String   @default("pending") // pending | completed | failed
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("seo_content_analyses")
}

model SeoContentBrief {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  primaryKeyword    String   @map("primary_keyword")
  secondaryKeywords String[] @map("secondary_keywords")
  topic             String?
  country           String?
  language          String?
  contentType       String?  @map("content_type")
  searchIntent      String?  @map("search_intent")
  briefData         Json?    @map("brief_data")
  status            String   @default("pending") // pending | completed | failed | approved
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drafts            SeoContentDraft[]

  @@index([workspaceId])
  @@map("seo_content_briefs")
}

model SeoContentDraft {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  briefId           String   @map("brief_id") @db.Uuid
  title             String
  content           String   @db.Text
  metadata          Json?
  status            String   @default("draft") // draft | approved | published
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brief             SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([briefId])
  @@map("seo_content_drafts")
}




model AgentConversation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AgentMessage[]

  @@index([workspaceId])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   // SYSTEM | USER | ASSISTANT | TOOL
  content        String   @db.Text
  toolCalls      Json?    @map("tool_calls")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("agent_messages")
}


model Automation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  type        String
  enabled     Boolean  @default(false)
  schedule    String?
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([workspaceId])
  @@map("automations")
}

model AutomationRun {
  id           String    @id @default(uuid()) @db.Uuid
  automationId String    @map("automation_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  status       String
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  error        String?   @db.Text
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([workspaceId])
  @@map("automation_runs")
}

model SocialContent {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  integrationId     String   @map("integration_id") @db.Uuid
  provider          String   @default("instagram")
  providerContentId String   @map("provider_content_id")
  contentType       String   @map("content_type")
  caption           String?  @db.Text
  permalink         String?
  mediaUrl          String?  @map("media_url")
  thumbnailUrl      String?  @map("thumbnail_url")
  publishedAt       DateTime @map("published_at")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metrics           SocialContentMetric[]

  @@unique([workspaceId, provider, providerContentId])
  @@index([workspaceId])
  @@map("social_content")
}

model SocialContentMetric {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  contentId       String   @map("content_id") @db.Uuid
  collectedAt     DateTime @map("collected_at")
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  views           Int      @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  replies         Int      @default(0)
  engagementRate  Float?   @map("engagement_rate")
  otherMetrics    Json?    @map("other_metrics")
  createdAt       DateTime @default(now()) @map("created_at")

  content         SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([workspaceId])
  @@map("social_content_metrics")
}

model SocialAccountMetric {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid
  collectedAt     DateTime @map("collected_at")
  metricName      String   @map("metric_name")
  metricValue     Float    @map("metric_value")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([integrationId])
  @@map("social_account_metrics")
}


model GoogleConnection {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  googleAccountId       String?   @map("google_account_id")
  email                 String?
  accessTokenEncrypted  String    @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  properties            SearchConsoleProperty[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("google_connections")
}

model SearchConsoleProperty {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  googleConnectionId String    @map("google_connection_id") @db.Uuid
  siteUrl            String    @map("site_url")
  permissionLevel    String?   @map("permission_level")
  lastSyncAt         DateTime? @map("last_sync_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  googleConnection   GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)
  
  dailyMetrics       SearchConsoleDaily[]
  queryMetrics       SearchConsoleQuery[]
  pageMetrics        SearchConsolePage[]
  deviceMetrics      SearchConsoleDevice[]
  countryMetrics     SearchConsoleCountry[]
  appearanceMetrics  SearchConsoleSearchAppearance[]

  @@unique([workspaceId, siteUrl])
  @@index([workspaceId])
  @@map("search_console_properties")
}

model SearchConsoleDaily {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  property    SearchConsoleProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@map("search_console_daily")
}

