{
  "services": {
    "api": {
      "root": "apps/api"
    },
    "web": {
      "root": "apps/web"
    }
  },
  "functions": {
    "apps/api/src/main.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
