{
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "apps/api/src/main.ts",
      "functions": {
        "apps/api/src/main.ts": {
          "maxDuration": 60
        }
      }
    },
    "web": {
      "root": "apps/web"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
