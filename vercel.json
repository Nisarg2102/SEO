{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/serverless.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/src/serverless.ts"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/package.json"
    }
  ]
}
