# Production Environment — FILL IN ALL VALUES BEFORE DEPLOYING
# Copy this file: cp .env.production.example .env.production
# NEVER commit .env.production to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=ai_marketing
POSTGRES_PASSWORD=                  # openssl rand -hex 32
POSTGRES_DB=ai_marketing_prod

# ─── Application ──────────────────────────────────────────────────────────────
# The public URL of your domain (no trailing slash)
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# JWT — minimum 32 random characters
JWT_SECRET=                         # openssl rand -hex 32

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_MODEL=gpt-4o
AI_API_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/gsc/callback

# ─── OpenSEO ──────────────────────────────────────────────────────────────────
OPENSEO_URL=
OPENSEO_API_KEY=

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=                 # openssl rand -hex 32

# ─── Postiz ───────────────────────────────────────────────────────────────────
POSTIZ_URL=
POSTIZ_API_KEY=
POSTIZ_WEBHOOK_SECRET=             # openssl rand -hex 32

# ─── Docker image configuration ───────────────────────────────────────────────
REGISTRY=your-registry.example.com
IMAGE_TAG=latest

# ─── nginx TLS ────────────────────────────────────────────────────────────────
# Absolute path on the HOST to your TLS certificate directory.
# Must contain: fullchain.pem, privkey.pem
TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com
DOMAIN=yourdomain.com
